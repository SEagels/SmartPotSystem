ENVIRONMENT=dev
DATABASE_URL=sqlite+aiosqlite:///./storage/smartpot.db
# DATABASE_URL=postgresql+asyncpg://smartpot:smartpot@localhost:5432/smartpot
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=smartpot-images
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
JWT_SECRET_KEY=change-me-in-production-use-random-string
JWT_EXPIRE_MINUTES=10080
YOLO_MODEL_PATH=./models/yolov11-plant.onnx

# ── 大模型养护建议配置（可选，不填则使用内置规则）──
# 申请 API Key 后填入下方，即可启用 AI 养护建议
# 支持 OpenAI / DeepSeek / 通义千问 / 智谱GLM 等兼容接口
LLM_API_KEY=
# 使用不同模型服务时修改此 URL：
#   OpenAI:    https://api.openai.com/v1/chat/completions
#   DeepSeek:  https://api.deepseek.com/v1/chat/completions
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   智谱GLM:   https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_API_URL=https://api.openai.com/v1/chat/completions
